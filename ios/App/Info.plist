	<string>Walkaround uses your location to stamp tamper-proof GPS coordinates and rental facility addresses onto vehicle evidence photos.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Walkaround saves verified PDF dispute packages and high-resolution comparison photos to your photo library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Walkaround allows you to select existing vehicle photos for inspection reports.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
